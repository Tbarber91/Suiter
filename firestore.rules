rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email'])
        && data.id is string
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200;
    }

    function isValidListing(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'type', 'ownerId'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 150
        && data.description is string && data.description.size() <= 4000
        && data.type is string && (data.type == 'ad' || data.type == 'service' || data.type == 'product' || data.type == 'shop')
        && data.ownerId is string && data.ownerId == request.auth.uid;
    }

    // Matches block user documents
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasAny(['name', 'email', 'avatarUrl', 'handle', 'bio', 'phone', 'location', 'role', 'isCertified', 'isRegulatoryCompliant', 'isVerifiedExperience', 'isGateLocked', 'encryptedAuthToken', 'skills', 'servicesProvided', 'portfolio', 'historyEngaged']);
      allow delete: if isOwner(userId);
    }

    // Matches block messages
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.senderId == request.auth.uid);
    }

    // Matches block directory listings
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(listingId) && isValidListing(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(listingId) && isValidListing(incoming())
        && (
          // Listing owner can update details
          (isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId) ||
          // Any verified signed-in reviewer can append reviews and update average rating
          (incoming().diff(existing()).affectedKeys().hasOnly(['reviews', 'rating']))
        );
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    // Matches block transactions
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Matches block reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == existing().userId || isOwner(existing().userId));
      allow delete: if isSignedIn() && (request.auth.uid == existing().userId || isOwner(existing().userId));
    }
  }
}
